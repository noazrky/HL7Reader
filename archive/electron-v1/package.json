{
  "name": "hl7-reader",
  "version": "1.0.0",
  "description": "Minimal desktop HL7 v2 parser",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.local.hl7reader",
    "productName": "HL7 Reader",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
